      </maml:navigationLink>
    </command:relatedLinks>
  </command:command>
  <command:command>
    <command:details>
      <command:name>Get-Greeting</command:name>
      <maml:description>
        <maml:para>Gets the names stored in the greeting store.</maml:para>
      </maml:description>
      <command:verb>Get</command:verb>
      <command:noun>Greeting</command:noun>
    </command:details>
    <maml:description>
      <maml:para>Gets a snapshot of names added with `Add-Greeting`.</maml:para>
      <maml:para>The cmdlet writes each stored name to the pipeline as a string.</maml:para>
    </maml:description>
    <command:syntax>
      <command:syntaxItem>
        <maml:name>Get-Greeting</maml:name>
      </command:syntaxItem>
    </command:syntax>
    <command:parameters />
    <command:inputTypes />
    <command:returnValues>
      <command:returnValue>
        <dev:type>
          <dev:name>System.String</dev:name>
        </dev:type>
        <maml:description>
          <maml:para>Each stored name.</maml:para>
        </maml:description>
      </command:returnValue>
    </command:returnValues>
    <maml:alertSet>
      <maml:alert>
        <maml:para>The greeting store is in-memory and is not persisted across sessions.</maml:para>
      </maml:alert>
    </maml:alertSet>
    <command:examples>
      <command:example>
        <maml:title>--------- Example 1 ---------</maml:title>
        <maml:introduction>
          <maml:para>Gets all stored names.</maml:para>
          <maml:para>&#x80;</maml:para>
          <maml:para>```powershell
Get-Greeting
```</maml:para>
        </maml:introduction>
        <dev:code />
        <dev:remarks />
      </command:example>
    </command:examples>
