<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- NOTE: F# dependencies. -->
    <PackageVersion Include="FSharp.Core" Version="10.0.102" />
    <!-- NOTE: PowerShell dependencies. Feedback Provider requires PowerShell SDK version 7.4.x. -->
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.4.13" />
    <!-- NOTE: Analyzer dependencies. -->
    <PackageVersion Include="Ionide.Analyzers" Version="0.14.11" />
    <!-- NOTE: Test dependencies. -->
    <PackageVersion Include="Expecto" Version="11.0.0-alpha8" />
    <PackageVersion Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
    <PackageVersion Include="FsCheck" Version="3.3.2" />
    <PackageVersion Include="Expecto.FsCheck" Version="11.0.0-alpha8" />
  </ItemGroup>
</Project>